# --- Core ---
# Local dev (docker compose): a plain connection string is fine for both.
# On Supabase: DATABASE_URL is the pooled "Transaction" connection (port 6543,
# add ?pgbouncer=true), DIRECT_URL is the direct connection (port 5432) —
# see README > Deploying with GitHub + Vercel + Supabase.
DATABASE_URL="postgresql://slowlydownward:slowlydownward@localhost:5432/slowlydownward"
DIRECT_URL="postgresql://slowlydownward:slowlydownward@localhost:5432/slowlydownward"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Supabase Storage (required for image uploads) ---
# Same Supabase project as DATABASE_URL above. Project Settings > API for
# both values; also create a public "site-images" bucket under Storage —
# see README > Image uploads. IMPORTANT: on Vercel these must be added
# again under Settings > Environment Variables — they are NOT picked up
# from a local .env file, and need their own redeploy to take effect.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (required for order/payment-link/welcome emails) ---
# Sign up at resend.com, verify a sending domain (or use their shared test
# domain to start), create an API key. See src/lib/integrations/resend.ts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Stripe (required) ---
# Get these from https://dashboard.stripe.com/apikeys (use test keys until you're ready to go live)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From the Stripe CLI (`stripe listen`) locally, or the webhook's signing secret in Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

STORE_URL="http://localhost:3000"

# --- UPS (optional, configure in Admin > Settings once you have credentials) ---
UPS_CLIENT_ID=""
UPS_CLIENT_SECRET=""
UPS_ACCOUNT_NUMBER=""
UPS_ENV="sandbox" # or "production"

# --- Royal Mail Click & Drop (optional) ---
ROYAL_MAIL_CLIENT_ID=""
ROYAL_MAIL_API_KEY=""

# --- Mailchimp (optional) ---
MAILCHIMP_API_KEY=""      # ends in -usX, the -usX part is the server prefix
MAILCHIMP_AUDIENCE_ID=""

# --- Xero (optional) ---
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/integrations/xero/callback"
